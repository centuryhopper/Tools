cmake_minimum_required(VERSION 4.4)

project({{ project_name }}
    VERSION 1.0
    LANGUAGES CXX
)

# =============================================================================
# 1. Language and output settings
# =============================================================================

set(CMAKE_CXX_STANDARD {{ cpp_standard }})
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Writes compile_commands.json, which clangd and clang-tidy read.
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

# All executables land in <build dir>/bin.
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)

# =============================================================================
# 2. Build options
# =============================================================================
#
#   cmake --preset debug -DSANITIZER=address     ASan + UBSan (memory errors, leaks, UB)
#   cmake --preset debug -DSANITIZER=thread      TSan + UBSan (data races, UB)
#   cmake --preset debug -DSANITIZER=undefined   UBSan only
#   cmake --preset debug -DWARNINGS_AS_ERRORS=ON fail the build on any warning
#
# ASan and TSan can't be combined, so give each its own build directory.

set(SANITIZER "" CACHE STRING "Sanitizer: address, thread, undefined, or empty")
set_property(CACHE SANITIZER PROPERTY STRINGS "" address thread undefined)

option(WARNINGS_AS_ERRORS "Treat compiler warnings as errors" OFF)

if(SANITIZER AND NOT SANITIZER MATCHES "^(address|thread|undefined)$")
    message(FATAL_ERROR
        "SANITIZER must be address, thread, undefined, or empty (got '${SANITIZER}')")
endif()

if(SANITIZER)
    message(STATUS "Sanitizer: ${SANITIZER}")
endif()

# =============================================================================
# 3. Compiler flags for our own code
# =============================================================================

set(PROJECT_WARNINGS
    -Wall
    -Wextra
    -Wpedantic
    -Wshadow
    -Wnon-virtual-dtor
    -Woverloaded-virtual
    -Wnull-dereference
    -Wimplicit-fallthrough
    -Wformat=2
)

if(WARNINGS_AS_ERRORS)
    list(APPEND PROJECT_WARNINGS -Werror)
endif()

# Stays empty when no sanitizer was requested.
set(SANITIZER_FLAGS "")

if(SANITIZER STREQUAL "address")
    set(SANITIZER_FLAGS -fsanitize=address,undefined)
elseif(SANITIZER STREQUAL "thread")
    set(SANITIZER_FLAGS -fsanitize=thread,undefined)
elseif(SANITIZER STREQUAL "undefined")
    set(SANITIZER_FLAGS -fsanitize=undefined)
endif()

# apply_project_options(<target>)
#
# Gives one of our own targets the include/ directory, the warnings above,
# debug-only standard library checks, and the chosen sanitizer.
# Never call this on third-party targets (fmt, exiv2, ...).
function(apply_project_options target)
    target_include_directories(${target} PRIVATE include)
    target_compile_options(${target} PRIVATE ${PROJECT_WARNINGS})

    # Debug only: bounds-check vector[], string[], span, and empty optional
    # access inside the standard library. Cheap, and it turns silent
    # corruption into an immediate assertion message.
    target_compile_definitions(${target} PRIVATE
        $<$<CONFIG:Debug>:_GLIBCXX_ASSERTIONS>
    )

    if(SANITIZER_FLAGS)
        target_compile_options(${target} PRIVATE
            ${SANITIZER_FLAGS}
            -fno-omit-frame-pointer
            -fno-sanitize-recover=undefined
        )
        target_link_options(${target} PRIVATE ${SANITIZER_FLAGS})
    endif()
endfunction()

# =============================================================================
# 4. Third-party dependencies
# =============================================================================

# cmake/dependencies.cmake finds or fetches the libraries.
include(cmake/dependencies.cmake)

# Every library our targets link against. Add new ones here only.
set(PROJECT_DEPENDENCIES
    TBB::tbb
)

# =============================================================================
# 5. Main executable
# =============================================================================

add_executable(${PROJECT_NAME})

# cmake/sources.cmake is generated by cppgen-cli and adds the .cpp files.
include(cmake/sources.cmake)

apply_project_options(${PROJECT_NAME})
target_link_libraries(${PROJECT_NAME} PRIVATE ${PROJECT_DEPENDENCIES})

{% if enable_tests %}
# =============================================================================
# 6. Tests
# =============================================================================

enable_testing()

add_executable(tests
    tests/test_main.cpp
)

# Compile the main target's sources into the tests too, minus its main().
get_target_property(MAIN_SOURCES ${PROJECT_NAME} SOURCES)
list(FILTER MAIN_SOURCES EXCLUDE REGEX "src/main\\.cpp$")
target_sources(tests PRIVATE ${MAIN_SOURCES})

apply_project_options(tests)
target_link_libraries(tests PRIVATE ${PROJECT_DEPENDENCIES})

add_test(NAME unit_tests COMMAND tests)

# ThreadSanitizer: hide false positives from uninstrumented runtimes (OpenMP).
if(SANITIZER STREQUAL "thread" AND EXISTS "${CMAKE_SOURCE_DIR}/tsan.supp")
    set_tests_properties(unit_tests PROPERTIES
        ENVIRONMENT "TSAN_OPTIONS=suppressions=${CMAKE_SOURCE_DIR}/tsan.supp")
endif()
{% endif %}

