cmake_minimum_required(VERSION 4.4)

project({{ project_name }}
    VERSION 1.0
    LANGUAGES CXX
)

set(CMAKE_CXX_STANDARD {{ cpp_standard }})
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)   # compile_commands.json for clangd / clang-tidy

set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)

# -------------------------
# Build options
# -------------------------
#   cmake --preset debug -DSANITIZER=address     ASan + UBSan (memory errors, leaks, UB)
#   cmake --preset debug -DSANITIZER=thread      TSan + UBSan (data races, UB)
#   cmake --preset debug -DSANITIZER=undefined   UBSan only
#   -DWARNINGS_AS_ERRORS=ON                      fail the build on any warning
#
# ASan and TSan can't be combined, so give each its own build directory.

set(SANITIZER "" CACHE STRING "Sanitizer: address, thread, undefined, or empty")
set_property(CACHE SANITIZER PROPERTY STRINGS "" address thread undefined)
option(WARNINGS_AS_ERRORS "Treat compiler warnings as errors" OFF)

if(SANITIZER AND NOT SANITIZER MATCHES "^(address|thread|undefined)$")
    message(FATAL_ERROR "SANITIZER must be address, thread, undefined, or empty (got '${SANITIZER}')")
endif()

set(PROJECT_WARNINGS
    -Wall
    -Wextra
    -Wpedantic
    -Wshadow
    -Wnon-virtual-dtor
    -Woverloaded-virtual
    -Wnull-dereference
    -Wimplicit-fallthrough
    -Wformat=2
    $<$<BOOL:${WARNINGS_AS_ERRORS}>:-Werror>
)

if(SANITIZER STREQUAL "address")
    set(SANITIZER_FLAGS -fsanitize=address,undefined)
elseif(SANITIZER STREQUAL "thread")
    set(SANITIZER_FLAGS -fsanitize=thread,undefined)
elseif(SANITIZER STREQUAL "undefined")
    set(SANITIZER_FLAGS -fsanitize=undefined)
endif()

# Applies warnings, debug checks and the chosen sanitizer to one of our own
# targets. Never call this on third-party targets (fmt, exiv2, ...).
function(apply_project_options target)
    target_include_directories(${target} PRIVATE include)
    target_compile_options(${target} PRIVATE ${PROJECT_WARNINGS})

    # Debug only: bounds-check vector[]/string[]/span and empty optional access
    # inside the standard library. Cheap; turns silent corruption into an
    # immediate assertion message.
    target_compile_definitions(${target} PRIVATE
        $<$<CONFIG:Debug>:_GLIBCXX_ASSERTIONS>
    )

    if(SANITIZER_FLAGS)
        target_compile_options(${target} PRIVATE
            ${SANITIZER_FLAGS}
            -fno-omit-frame-pointer
            -fno-sanitize-recover=undefined
        )
        target_link_options(${target} PRIVATE ${SANITIZER_FLAGS})
    endif()
endfunction()

if(SANITIZER)
    message(STATUS "Sanitizer: ${SANITIZER}")
endif()


