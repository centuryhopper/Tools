# -------------------------
# Main executable
# -------------------------

add_executable(${PROJECT_NAME})

include(cmake/sources.cmake)   # generated by cppgen-cli

apply_project_options(${PROJECT_NAME})

{% if enable_tests %}

# -------------------------
# Tests
# -------------------------

enable_testing()

add_executable(tests
    tests/test_main.cpp
)

# Reuse every source cppgen added to the main target, except its main()
get_target_property(LIB_SOURCES ${PROJECT_NAME} SOURCES)
list(FILTER LIB_SOURCES EXCLUDE REGEX "src/main\\.cpp$")
target_sources(tests PRIVATE ${LIB_SOURCES})

apply_project_options(tests)

add_test(NAME unit_tests COMMAND tests)

# ThreadSanitizer: hide false positives from uninstrumented runtimes (OpenMP).
if(SANITIZER STREQUAL "thread" AND EXISTS "${CMAKE_SOURCE_DIR}/tsan.supp")
    set_tests_properties(unit_tests PROPERTIES
        ENVIRONMENT "TSAN_OPTIONS=suppressions=${CMAKE_SOURCE_DIR}/tsan.supp")
endif()

{% endif %}






































































