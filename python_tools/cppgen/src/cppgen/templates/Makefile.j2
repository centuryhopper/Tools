PRESET ?= release
BUILD_DIR := build/$(PRESET)
APP   := $(BUILD_DIR)/bin/{{ project_name }}
CACHE := $(BUILD_DIR)/CMakeCache.txt

# Changing either presets file triggers a reconfigure.
# $(wildcard ...) is empty when CMakeUserPresets.json doesn't exist.
PRESET_FILES := CMakePresets.json $(wildcard CMakeUserPresets.json)

# Under the tsan preset, `make run` uses tsan.supp (if present) to hide OpenMP
# false positives. ctest gets the same file from CMakeLists.txt.
TSAN_SUPP := $(wildcard $(CURDIR)/tsan.supp)
RUN_ENV := $(if $(and $(filter tsan,$(PRESET)),$(TSAN_SUPP)),TSAN_OPTIONS="suppressions=$(TSAN_SUPP) $(TSAN_OPTIONS)")

.PHONY: all configure build run clean asan tsan{% if enable_tests %} test{% endif %}


all: build

# Configure only when the build tree is missing or the presets changed.
# Assumes each configure preset uses binaryDir = ${sourceDir}/build/${presetName}.
$(CACHE): $(PRESET_FILES)
	cmake --preset $(PRESET)
	@touch $@

configure: $(CACHE)

build: $(CACHE)
	cmake --build --preset $(PRESET)

# Pass program arguments with: make run ARGS="--flag value"
run: build
	$(RUN_ENV) ./$(APP) $(ARGS)

{% if enable_tests %}
test: build
	ctest --preset $(PRESET) --output-on-failure

# Shortcuts: build and run the tests under a sanitizer
asan:
	$(MAKE) test PRESET=asan

tsan:
	$(MAKE) test PRESET=tsan

{% else %}
# Shortcuts: build and run the app under a sanitizer (pass ARGS as usual)
asan:
	$(MAKE) run PRESET=asan

tsan:
	$(MAKE) run PRESET=tsan

{% endif %}
clean:
	rm -rf build
